# Supabase: copy this file to .env.local and fill in the values.
# Get both from the Supabase Dashboard: open your project and click "Connect"
# (top bar), or go to Settings -> API Keys.
# Use the publishable key (sb_publishable_...) or the legacy anon key (eyJ...).
# The anon/public key is safe to use in the browser because RLS protects the data.
# NEVER put the secret/service_role key in a VITE_ variable.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
